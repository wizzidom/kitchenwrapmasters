# =====================================================
# KITCHEN WRAP MASTERS — Environment Variables
#
# DO NOT commit real values to Git.
# Add these in: Netlify Dashboard → Site → Environment Variables
#
# This file is safe to commit — it contains no real secrets.
# =====================================================

# ---------------------------------------------------------------------------
# PayFast
# ---------------------------------------------------------------------------

# Your PayFast Merchant ID (visible in your PayFast dashboard — not secret)
PAYFAST_MERCHANT_ID=25068580

# Your PayFast Merchant Key (13 characters, from PayFast Dashboard → Settings → Integration)
# Used server-side only in the create-payment function — never exposed to the browser
PAYFAST_MERCHANT_KEY=your_13_char_merchant_key_here

# Your PayFast Passphrase (set in PayFast Dashboard → Settings → Integration)
# KEEP THIS SECRET — never share or commit the real value
PAYFAST_PASSPHRASE=your_payfast_passphrase_here

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Your Supabase project URL
SUPABASE_URL=https://jxhrbkhzmhnrlqcxgvxa.supabase.co

# Supabase service_role key (from Supabase Dashboard → Settings → API)
# This key bypasses Row Level Security — KEEP IT SECRET
# Do NOT use the anon/public key here — it won't have write permissions
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Your live site URL — update this when your domain goes live
# Used to build PayFast return_url, cancel_url and notify_url
SITE_URL=https://classy-gecko-298aad.netlify.app
# Once domain is connected: SITE_URL=https://kitchenwrapmasters.co.za

# ---------------------------------------------------------------------------
# HOW TO ADD THESE TO NETLIFY:
#
# 1. Go to https://app.netlify.com
# 2. Select your site (classy-gecko-298aad)
# 3. Site configuration → Environment variables
# 4. Click "Add a variable" for each one above
# 5. Paste the real value (not the placeholder)
# 6. Redeploy your site (Deploys → Trigger deploy)
# =====================================================
